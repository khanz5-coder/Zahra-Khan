rendering_html <- function(url, wait_seconds = 5) {
job <- ChromoteSession$new()
job$Page$navigate(url)
job$Page$loadEventFired()
Sys.sleep(wait_seconds)
html_content <- job$Runtime$evaluate("document.documentElement.outerHTML")$result$value
job$close()
return(html_content)
}
