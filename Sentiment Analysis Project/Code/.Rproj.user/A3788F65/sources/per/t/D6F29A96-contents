#FINAL MAIN GRAPH
df10 <- df %>%
  filter(date >= as.Date("1912-01-01"), date <= as.Date("1924-12-31")) %>%
  mutate(binary_class = ifelse(predicted_class !=0, 1, 0)) %>%
  group_by(month = floor_date(date, 'month')) %>%
  mutate(total = n()) %>%
  group_by(month, binary_class) %>%
  summarise(count = n(), total = first(total), .groups = "drop") %>%
  mutate(percentage = (count/total) * 100) %>%
  filter(binary_class == 1) %>%
  ungroup() %>%
  select(-month)

df10.ts <- ts(df10$percentage, end = c(1924,5), frequency = 12)
autoplot(df10.ts) +
  labs(title = "Nativism in Organized Labor: 1914-1926") +
  ylab("Monthly Nativst Percentage") 

df10sma.ts <- SMA(df10.ts, n = 12)
autoplot(df10sma.ts)

df10p <- data.frame(
  time = as.numeric(time(df10sma.ts)),
  val = as.numeric(df10sma.ts)
)
ggplot(df10p, aes(x = time, y = val)) +
  geom_line(colour = "blue") +
  annotate("rect", xmin=1912, xmax = 1917, ymin=-Inf, ymax=Inf,
           alpha=0.15, fill="yellow") +
  annotate("rect", xmin=1917, xmax = 1920, ymin=-Inf, ymax=Inf,
           alpha=0.15, fill="lightblue") +
  annotate("rect", xmin=1920, xmax = 1924, ymin=-Inf, ymax=Inf,
           alpha=0.15, fill="lightgreen") +
  annotate("text", x = 1914.5, y = Inf, label = "Pre-Involvement",
           vjust=2, size=3.5, fontface="bold") +
  annotate("text", x = 1918, y = Inf, label = "WW1 US Involvement",
           vjust=2, size=3.5, fontface="bold") +
  annotate("text", x = 1921.5, y = Inf, label = "Post-War",
           vjust=2, size=3.5, fontface="bold") +
  labs(title = "Labor Centered Nativism 1914-1924") +
  ylab("Monthly Nativist Percentage") +
  xlab("Year") +
  theme_classic() +
  theme(
    plot.title = element_text(face = "bold", size = 15, hjust=0.5),
    axis.title = element_text(size = 10),
    panel.grid.minor = element_blank()
  )
  
