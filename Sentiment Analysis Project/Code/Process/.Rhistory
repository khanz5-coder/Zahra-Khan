y = "Average Natvism Per Year"
)
dfm1 <- df %>%
filter(date >= as.Date("1900-01-01"), date <= as.Date("1930-12-31")) %>%
group_by(month = floor_date(date, 'month')) %>%
mutate(total = n()) %>%
group_by(month, predicted_class) %>%
summarise(count = n(), total = first(total), .groups="drop") %>%
mutate(percentage = (count/total) * 100) %>%
filter(predicted_class == 1) %>%
ungroup() %>%
select(-month)
dfm1.ts <- ts(dfm1$percentage, end = c(1930, 12), frequency = 12)
dfm1sma <- SMA(dfm1.ts, window = 12)
p <- autoplot(dfm1sma)+
labs(
title = " Nativism in Organized Labor: 1900-1988",
x = "Date",
y = "Average Natvism Per Year"
)
f <- ggplotly(p)
p
df10p <- data.frame(
time = as.numeric(time(dfm1sma)),
val = as.numeric(dfm1sma)
)
ggplot(df10p, aes(x = time, y = val)) +
geom_line(colour = "blue") +
annotate("rect", xmin=1907, xmax = 1909, ymin=-Inf, ymax=Inf,
alpha=0.15, fill="yellow") +
annotate("rect", xmin=1917, xmax = 1919, ymin=-Inf, ymax=Inf,
alpha=0.15, fill="lightblue") +
annotate("rect", xmin=1921, xmax = 1922, ymin=-Inf, ymax=Inf,
alpha=0.15, fill="lightgreen") +
annotate("rect", xmin=1910, xmax = 1911, ymin=-Inf, ymax=Inf,
alpha=0.15, fill="lightgreen") +
annotate("text", x = 1906, y = Inf, label = "Anti-Asian Riots",
vjust=2, size=3.5, fontface="bold") +
annotate("text", x = 1918, y = Inf, label = "WW1",
vjust=2, size=3.5, fontface="bold") +
annotate("text", x = 1921.5, y = Inf, label = "Post-War Recession",
vjust=2, size=3.5, fontface="bold") +
annotate("text", x = 1910, y = Inf, label = "Recession",
vjust=2, size=3.5, fontface="bold") +
labs(title = "Labor Centered Nativism 1908-1930") +
ylab("Monthly Nativist Percentage") +
xlab("Year") +
theme_classic() +
theme(
plot.title = element_text(face = "bold", size = 15, hjust=0.5),
axis.title = element_text(size = 10),
panel.grid.minor = element_blank()
)
