Dail_speech <- quanteda::dfm(
quanteda::tokens_lookup(ddebate, dictionary = data_dictionary_LaverGarry)
)
Dail_speech
speech_df <- convert(Dail_speech, to = "data.frame")
speech_df$party <- ddebates$party
speech_df$text <- ddebates$text
speech_df$ntokens <- speech_topics$ntokens
head(speech_df)
cols <- setdiff(names(speech_df), c("doc_id", "party"))
speech_df <- speech_df %>%
select("environment.pro environment", "environment.con environment" ,
"values.conservative","values.liberal", "law_and_order.law-conservative",
"law_and_order.law-liberal", "party", "text", "ntokens")
speech_ideo <- speech_df %>%
summarise(
env_pro = sum(`environment.pro environment`)/ sum(ntokens),
env_con = sum(`environment.con environment`)/ sum(ntokens),
values_con = sum(`values.conservative`)/ sum(ntokens),
values_lib = sum(`values.liberal`)/ sum(ntokens),
law_lib = sum(`law_and_order.law-liberal`)/ sum(ntokens),
law_con = sum(`law_and_order.law-conservative`)/ sum(ntokens),
)
speech_ideo
speech_ideo <- speech_df %>%
summarise(
env_pro = sum(`environment.pro environment`)/ sum(ntokens),
env_con = sum(`environment.con environment`)/ sum(ntokens),
values_con = sum(`values.conservative`)/ sum(ntokens),
values_lib = sum(`values.liberal`)/ sum(ntokens),
law_lib = sum(`law_and_order.law-liberal`)/ sum(ntokens),
law_con = sum(`law_and_order.law-conservative`)/ sum(ntokens),
)
party_leaning <- speech_df %>%
group_by(party) %>%
summarise(
env_pro = sum(`environment.pro environment`)/ sum(ntokens),
env_con = sum(`environment.con environment`)/ sum(ntokens),
values_con = sum(`values.conservative`)/ sum(ntokens),
values_lib = sum(`values.liberal`)/ sum(ntokens),
law_lib = sum(`law_and_order.law-liberal`)/ sum(ntokens),
law_con = sum(`law_and_order.law-conservative`)/ sum(ntokens),
)
party_leaning <- party_leaning %>%
mutate(
val_score = values_con / (values_con  + values_lib),
env_score = env_pro/ (env_pro = env_con),
law_score = law_lib / (law_lib - law_con)
)
party_leaning
party_leaning <- speech_df %>%
group_by(party) %>%
summarise(
env_pro = sum(`environment.pro environment`)/ sum(ntokens) * 1000,
env_con = sum(`environment.con environment`)/ sum(ntokens) * 1000,
values_con = sum(`values.conservative`)/ sum(ntokens) * 1000,
values_lib = sum(`values.liberal`)/ sum(ntokens) * 1000,
law_lib = sum(`law_and_order.law-liberal`)/ sum(ntokens) * 1000,
law_con = sum(`law_and_order.law-conservative`)/ sum(ntokens) * 1000,
)
party_leaning
party_leaning <- party_leaning %>%
mutate(
val_score = values_con / (values_con  + values_lib) * 1000,
env_score = env_pro/ (env_pro = env_con) * 1000,
law_score = law_lib / (law_lib - law_con) * 1000
)
View(party_leaning)
party_leaning %>%
select(party, val_score, env_score, law_score) %>%
pivot_longer(cols = c(val_score, env_score, law_score),
names_to = "ideo", values_to = "score") %>%
ggplot(aes(x = party, y = score, fill = party)) +
geom_poiny(size =4) +
geom_vline(xintercept = 0.5, linetype = "dashes", color = "blue") +
facet_wrap(~dimension) +
theme_minimal()
